color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/71a735ffc038acaed1889e2baa6108b9c16f0dc5-165x44.svg" alt="Terraform" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/38beb94b86582a033eba7b8085a5b4f608840ae5-141x31.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/f90f7f0b84c285e5a2c3dcc8764aae3eb74cf701-141x31.svg" alt="Sentry" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/6fb1ed1f3037743d79b6d2580d64179b75d893e3-61x36.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/477ff12eca622016612d5837b67bec8fbd3899e8-61x36.svg" alt="AWS" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/0bf4e8e7349b5332180b8b875dba2c780694414f-156x40.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/b7e4f274d9789cf6709450c85ee987064b78d784-156x40.svg" alt="MongoDB" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/9cdf5ed2ae750f0b6795490071eed41576bd1e1a-189x24.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/9cdf5ed2ae750f0b6795490071eed41576bd1e1a-189x24.svg" alt="Atlassian" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/cfff753bcc44a9d6642730f19ebd5a09a60bca4b-146x36.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/5bd06742093289d7f7dd03b3945cc35d823d5388-146x36.svg" alt="Datadog" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/c07e39d9053c9eb71e2fd92a503aa14206036e08-126x36.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/7522fc92399dcb4a68f11c7e147e711fcadbe75b-126x36.svg" alt="GitHub" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/3a9531979d18b698a65633ba8768aedc7e16d5e7-120x24.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/dfe2bb49cbe6a11d747deb00e01474b0ac4a8de8-120x24.svg" alt="Vercel" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li><li class="LogoWall-module-scss-module__JMoFRq__item"><div class="LogoWall-module-scss-module__JMoFRq__target"><picture class="LogoWall-module-scss-module__JMoFRq__logo"><source srcSet="https://cdn.sanity.io/images/4zrzovbb/claude-com/dc0512750af90c283790aff69b7ddd8567f0f340-142x28.svg" media="(prefers-color-scheme: dark)"/><img src="https://cdn.sanity.io/images/4zrzovbb/claude-com/381cea7f0fc11a867d2e8fa86028a1bc87fd9aad-142x28.svg" alt="New Relic" class="Logo-module-scss-module__WopJ-q__logo" loading="lazy"/></picture></div></li></ul></div><div class="LogoWall-module-scss-module__JMoFRq__splitContent"><h2 class="Heading-module-scss-module__RUqAea__heading text-headline-5-serif Heading-module-scss-module__RUqAea__balance LogoWall-module-scss-module__JMoFRq__splitHeadline">Connects with your favorite command line tools<!-- --></h2><p class="LogoWall-module-scss-module__JMoFRq__splitBody text-body-3">Your terminal is where real work happens. Claude Code connects with the tools that power development—deployment, databases, monitoring, version control. Rather than adding another interface to juggle, it enhances your existing stack.<!-- --></p></div></div></div></section><div style="display:none" aria-hidden="true"></div><section id="faq" data-section="faq" class="SectionWrapper-module-scss-module__C2Ksua__wrapper theme-main"><div class="SectionWrapper-module-scss-module__C2Ksua__borderTop"></div><div class="container"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I get started with Claude?","acceptedAnswer":{"@type":"Answer","text":"You can access Claude Code with a Claude Pro or Max plan, a Team or Enterprise plan premium seat, or a Claude Console account. Download Claude Code and sign in with your respective Claude or Console credentials."}},{"@type":"Question","name":"What kinds of tasks can Claude Code handle?","acceptedAnswer":{"@type":"Answer","text":"Claude Code excels at both routine development tasks like bug fixes and testing, as well as transformative work like refactors and feature implementation that require deep codebase understanding."}},{"@type":"Question","name":"How does Claude Code work with my existing tools?","acceptedAnswer":{"@type":"Answer","text":"Claude Code runs in your terminal and works alongside your preferred IDE and development tools without requiring you to change your workflow. Claude Code can also use command line tools (like Git) and MCP servers (like GitHub) to extend its own capabilities using your tools."}},{"@type":"Question","name":"Is Claude Code secure?","acceptedAnswer":{"@type":"Answer","text":"Yes. Claude Code runs locally in your terminal and talks directly to model APIs without requiring a backend server or remote code index. It also asks for permission before making changes to your files or running commands."}},{"@type":"Question","name":"What are the system requirements to run Claude Code?","acceptedAnswer":{"@type":"Answer","text":"Claude Code works on macOS, Linux, and Windows. See full system requirements."}},{"@type":"Question","name":"How much does Claude Code cost?","acceptedAnswer":{"@type":"Answer","text":"When used with a Claude Console account, Claude Code consumes API tokens at standard API pricing."}},{"@type":"Question","name":"Does Claude Code work with the Claude desktop app?","acceptedAnswer":{"@type":"Answer","text":"Yes. Max, Pro, Team, and Enterprise users can access Claude Code on the Claude desktop app."}},{"@type":"Question","name":"What is fast mode on Claude Code?","acceptedAnswer":{"@type":"Answer","text":"Fast mode is a high-speed configuration for Opus 5, making the model 2.5x faster at a higher cost per token. Fast mode is available: In research preview on Claude Code, and is priced at $10/$50 per million tokens. On consumption-based plans. Via usage credits for users on subscription plans."}}]}</script><div class="IntroBlock-module-scss-module__pE7t6q__introBlock"><div class="Illustration-module-scss-module__aI5yga__base Illustration-module-scss-module__aI5yga__pictogram Illustration-module-scss-module__aI5yga__size-large" aria-hidden="true"></div><h2 class="Heading-module-scss-module__RUqAea__heading text-headline-1-serif Heading-module-scss-module__RUqAea__balance AnimatedHeading-module-scss-module__nJBogG__heading IntroBlock-module-scss-module__pE7t6q__headline" style="--word-stagger:0s"><span class="AnimatedHeading-module-scss-module__nJBogG__word" style="--word-index:0">FAQ</span></h2></div><div class="Faq-module-scss-module__XHzreq__accordion"><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_udm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_udm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">How do I get started with Claude?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_udm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_udm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>You can access Claude Code with a Claude Pro or Max plan, a Team or Enterprise plan premium seat, or a Claude Console account. <a href="https://code.claude.com/docs/en/overview" target="_blank" rel="noopener noreferrer" data-cta-position="faq" data-cta-url="https://code.claude.com/docs/en/overview">Download Claude Code</a> and sign in with your respective Claude or Console credentials.</p></div></div></div><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_1edm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_1edm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">What kinds of tasks can Claude Code handle?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_1edm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_1edm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>Claude Code excels at both routine development tasks like bug fixes and testing, as well as transformative work like refactors and feature implementation that require deep codebase understanding.</p></div></div></div><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_1udm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_1udm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">How does Claude Code work with my existing tools?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_1udm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_1udm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>Claude Code runs in your terminal and works alongside your preferred IDE and development tools without requiring you to change your workflow. Claude Code can also use command line tools (like Git) and MCP servers (like GitHub) to extend its own capabilities using your tools.</p></div></div></div><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_2edm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_2edm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">Is Claude Code secure?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_2edm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_2edm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>Yes. Claude Code runs locally in your terminal and talks directly to model APIs without requiring a backend server or remote code index. It also asks for permission before making changes to your files or running commands.</p></div></div></div><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_2udm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_2udm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">What are the system requirements to run Claude Code?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_2udm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_2udm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>Claude Code works on macOS, Linux, and Windows. <a href="https://docs.claude.com/en/docs/claude-code/setup#system-requirements" target="_blank" rel="noopener noreferrer" data-cta-position="faq" data-cta-url="https://docs.claude.com/en/docs/claude-code/setup#system-requirements">See full system requirements</a>.</p></div></div></div><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_3edm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_3edm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">How much does Claude Code cost?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_3edm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_3edm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>When used with a Claude Console account, Claude Code consumes API tokens at <a href="https://claude.com/pricing#api" target="_blank" rel="noopener noreferrer" data-cta-position="faq" data-cta-url="https://claude.com/pricing#api">standard API pricing</a>.</p></div></div></div><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_3udm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_3udm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">Does Claude Code work with the Claude desktop app?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_3udm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_3udm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>Yes. Max, Pro, Team, and Enterprise users can access Claude Code on the <a href="https://claude.com/download" target="_blank" rel="noopener noreferrer" data-cta-position="faq" data-cta-url="https://claude.com/download">Claude desktop app</a>.</p></div></div></div><div class="Faq-module-scss-module__XHzreq__item"><h3 class="Faq-module-scss-module__XHzreq__heading"><button id="_R_4edm9bsnpfiv9lb_-trigger" type="button" class="Faq-module-scss-module__XHzreq__trigger" aria-expanded="false" aria-controls="_R_4edm9bsnpfiv9lb_-content"><span class="text-headline-6-serif">What is fast mode on Claude Code?</span><span class="Faq-module-scss-module__XHzreq__icon" aria-hidden="true"><span class="Faq-module-scss-module__XHzreq__iconBar"></span><span class="Faq-module-scss-module__XHzreq__iconBarVertical"></span></span></button></h3><div id="_R_4edm9bsnpfiv9lb_-content" class="Faq-module-scss-module__XHzreq__content" role="region" aria-labelledby="_R_4edm9bsnpfiv9lb_-trigger" hidden=""><div class="Faq-module-scss-module__XHzreq__body text-body-2"><p>Fast mode is a high-speed configuration for Opus 5, making the model 2.5x faster at a higher cost per token. Fast mode is available:</p><ul><li>In research preview on Claude Code, and is priced at $10/$50 per million tokens.</li><li>On consumption-based plans.</li><li>Via usage credits for users on subscription plans.</li></ul></div></div></div></div></div></section><div style="display:none" aria-hidden="true"></div><section id="resources" data-section="resources" class="SectionWrapper-module-scss-module__C2Ksua__wrapper theme-main"><div class="SectionWrapper-module-scss-module__C2Ksua__borderTop"></div><div class="container"><div class="Resources-module-scss-module__sKmSWG__root"><div class="IntroBlock-module-scss-module__pE7t6q__introBlock"><div class="Illustration-module-scss-module__aI5yga__base Illustration-module-scss-module__aI5yga__pictogram Illustration-module-scss-module__aI5yga__size-large" aria-hidden="true"></div><h2 class="Heading-module-scss-module__RUqAea__heading text-headline-1-serif Heading-module-scss-module__RUqAea__balance AnimatedHeading-module-scss-module__nJBogG__heading IntroBlock-module-scss-module__pE7t6q__headline" style="--word-stagger:0s"><span class="AnimatedHeading-module-scss-module__nJBogG__word" style="--word-index:0">Get the technical rundown<!-- --></span></h2></div><div class="AnimatedReveal-module-scss-module__O7RNzW__container Resources-module-scss-module__sKmSWG__items Resources-module-scss-module__sKmSWG__grid" style="--reveal-y:20px;--reveal-duration:0.75s;--reveal-delay:0s;--reveal-stagger:0.1s"><div style="--reveal-index:0"><a href="https://code.claude.com/docs/en/overview" class="CardLink-module-scss-module__nIezoW__card Resources-module-scss-module__sKmSWG__gridCard" target="_blank" rel="noopener noreferrer" data-cta-position="resources" data-cta-url="https://code.claude.com/docs/en/overview"><h3 class="CardLink-module-scss-module__nIezoW__title text-body-2-serif">Claude Code documentation<!-- --></h3><span class="CardLink-module-scss-module__nIezoW__linkLabel text-caption"><div class="flex items-center justify-center CardLink-module-scss-module__nIezoW__icon" style="width:20px;height:20px"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="shrink-0 CardLink-module-scss-module__nIezoW__icon" aria-hidden="true"><path d="M7.59608 7.99088C9.01909 7.43035 10.5884 7.86617 11.5326 8.96256L11.7123 9.19108C11.7695 9.27004 11.8243 9.35165 11.8754 9.4362L12.018 9.69792L12.0531 9.79362C12.1116 10.0184 12.0068 10.2611 11.7904 10.3678C11.5738 10.4744 11.3168 10.4098 11.1742 10.2262L11.1205 10.1403L11.018 9.95377C10.9816 9.8936 10.9434 9.83515 10.9027 9.77897L10.7738 9.61491C10.0992 8.83195 8.97855 8.52172 7.96327 8.92155C6.67866 9.42757 6.04713 10.8791 6.55311 12.1637L7.83631 15.4206C8.34249 16.7049 9.794 17.3357 11.0785 16.8298C12.3629 16.3236 12.9937 14.8721 12.4877 13.5876L12.3969 13.3551C12.2957 13.0983 12.4213 12.808 12.6781 12.7067C12.935 12.6055 13.2253 12.732 13.3265 12.9889L13.4