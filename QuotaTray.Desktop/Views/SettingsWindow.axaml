<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuotaTray.Desktop.ViewModels"
        x:Class="QuotaTray.Desktop.Views.SettingsWindow"
        x:DataType="vm:QuotaViewModel"
        Title="환경 설정"
        Width="390"
        SizeToContent="Height"
        MaxHeight="520"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <!-- Main Outer Container with Drop Shadow -->
    <Border Margin="10" 
            Background="#16181F" 
            BorderBrush="#2A2D3A" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="16,14"
            BoxShadow="0 4 20 0 #A0000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12 15.5A3.5 3.5 0 0 1 8.5 12A3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5a3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97c0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1c0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3 1.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66Z" 
                          Fill="#818CF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="설정" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Classes="iconButton" Click="CloseButton_Click" ToolTip.Tip="닫기" Padding="6">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" 
                          Fill="#94A3B8" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- TAB BAR -->
            <Border Grid.Row="1" Background="#1A1D27" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GeneralTabRadio" Content="일반 설정" IsChecked="True" Classes="tabRadio" Click="TabRadio_Click" Margin="0,0,4,0"/>
                    <RadioButton x:Name="ProvidersTabRadio" Content="프로바이더 및 인증" Classes="tabRadio" Click="TabRadio_Click"/>
                </StackPanel>
            </Border>

            <!-- TAB 1: GENERAL PREFERENCES -->
            <Grid Grid.Row="2" x:Name="GeneralTabContent" IsVisible="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                        <!-- Interval & Threshold Section -->
                        <Border Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="자동 갱신 및 경고 기준" FontSize="12" FontWeight="SemiBold" Foreground="#818CF8" Margin="0,0,0,10"/>

                                <!-- Auto Refresh Interval -->
                                <Grid Margin="0,0,0,10" ColumnDefinitions="*,110">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="자동 갱신 주기" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0"/>
                                        <TextBlock Text="백그라운드 쿼터 조회 간격" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding RefreshIntervalOptions}" 
                                              SelectedItem="{Binding SelectedRefreshIntervalOption, Mode=TwoWay}"
                                              Classes="modernCombo"
                                              Width="105"
                                              HorizontalAlignment="Right">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingOptionItem">
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#E2E8F0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Separator Background="#262B3A" Height="1" Margin="0,4,0,10"/>

                                <!-- Warning Threshold -->
                                <Grid ColumnDefinitions="*,110">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="쿼터 부족 경고 기준" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0"/>
                                        <TextBlock Text="아이콘 주황/빨강 전환 및 알림" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding WarningThresholdOptions}" 
                                              SelectedItem="{Binding SelectedWarningThresholdOption, Mode=TwoWay}"
                                              Classes="modernCombo"
                                              Width="105"
                                              HorizontalAlignment="Right">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingOptionItem">
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#E2E8F0"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Behavior Section -->
                        <Border Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="시스템 동작" FontSize="12" FontWeight="SemiBold" Foreground="#818CF8" Margin="0,0,0,10"/>

                                <!-- Auto Startup -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Windows 시작 시 자동 실행" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0"/>
                                        <TextBlock Text="부팅 시 시스템 트레이에서 백그라운드 시작" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" 
                                              x:Name="StartupCheckBox" 
                                              IsCheckedChanged="StartupCheckBox_Changed"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic Logs Section -->
                        <Border Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="진단 보고서 복사" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0"/>
                                    <TextBlock Text="현재 연결 상태 및 디버그 정보를 클립보드에 복사" FontSize="10" Foreground="#64748B"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="pillButton" Click="CopyDiagnostics_Click" VerticalAlignment="Center">
                                    <TextBlock Text="복사" FontSize="11"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: PROVIDERS & AUTHENTICATION -->
            <Grid Grid.Row="2" x:Name="ProvidersTabContent" IsVisible="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                        <TextBlock Text="모니터링할 AI Provider를 선택하고 API Key를 등록하세요." FontSize="11" Foreground="#64748B" Margin="2,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding AvailableProviders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderToggleOption">
                                    <Border Margin="0,0,0,6" Padding="10,8" Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="10">
                                        <StackPanel Orientation="Vertical">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0" 
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                          VerticalAlignment="Center"/>

                                                <!-- Official Brand Asset Icon (Unified Dark Chip) -->
                                                <Border Grid.Column="1" Width="26" Height="26" Background="#161922" BorderBrush="#2A3042" BorderThickness="1" CornerRadius="6" Margin="4,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding IconImage}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        <Path Data="{Binding IconSvgData}" Fill="{Binding IconColor}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                    </Panel>
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding Title}" 
                                                           FontSize="13" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#F1F5F9" 
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Auth Status Badge Pill -->
                                                <Border Grid.Column="3" 
                                                        Background="{Binding AuthStatusBgBrush}" 
                                                        CornerRadius="4" 
                                                        Padding="6,2" 
                                                        Margin="6,0,8,0" 
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AuthStatusBadgeText}" 
                                                               FontSize="10" 
                                                               FontWeight="Medium" 
                                                               Foreground="{Binding AuthStatusBadgeBrush}"/>
                                                </Border>

                                                <!-- Action buttons (API Key / CLI Login) -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Classes="pillButton" 
                                                            Click="ToggleApiKeyInput_Click" 
                                                            IsEnabled="{Binding IsActionsEnabled}"
                                                            ToolTip.Tip="API Key 설정" 
                                                            Margin="2,0">
                                                        <TextBlock Text="Key" FontSize="10"/>
                                                    </Button>
                                                    <Button Classes="pillButton" 
                                                            Click="LaunchProviderCli_Click" 
                                                            IsEnabled="{Binding IsActionsEnabled}"
                                                            ToolTip.Tip="CLI 로그인 실행" 
                                                            IsVisible="{Binding CliLoginCommand, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                                                            Margin="2,0">
                                                        <TextBlock Text="CLI" FontSize="10"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- API Key Input Accordion Drawer -->
                                            <Border Background="#141620" 
                                                    CornerRadius="8" 
                                                    Padding="10,8" 
                                                    Margin="0,8,0,0" 
                                                    IsVisible="{Binding IsEditingKey}">
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding Title, StringFormat='{}{0} API Key 또는 토큰을 입력하세요'}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <TextBox Grid.Column="0" 
                                                                 Text="{Binding ApiKey, Mode=TwoWay}" 
                                                                 PasswordChar="•" 
                                                                 Watermark="sk-..." 
                                                                 Classes="modernTextBox" 
                                                                 Margin="0,0,6,0"/>
                                                        <Button Grid.Column="1" 
                                                                Classes="pillButton" 
                                                                Click="SaveApiKey_Click" 
                                                                Margin="0,0,4,0">
                                                            <TextBlock Text="저장" FontSize="10"/>
                                                        </Button>
                                                        <Button Grid.Column="2" 
                                                                Classes="pillButton" 
                                                                Click="ToggleApiKeyInput_Click">
                                                            <TextBlock Text="취소" FontSize="10"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- FOOTER -->
            <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="QuotaTray v1.0 · Cross-Platform" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="pillButton" Click="CloseButton_Click">
                    <TextBlock Text="닫기" FontSize="11"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
