<Window x:Class="QuotaTray.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:QuotaTray.App.Converters"
        xmlns:viewmodels="clr-namespace:QuotaTray.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewmodels:QuotaViewModel}"
        Title="환경 설정"
        Width="460"
        Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <!-- Ultra-Modern Dark Slim ScrollBar Style -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="#33384B" CornerRadius="2.5" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDarkScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Width="5"
                                       Margin="2,0,0,0"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IconButton Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D313E"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B4052"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Button Style -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D3346"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D455D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F5877"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab RadioButton Style -->
        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242938"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E364F"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#222634"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#383E54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#14161E"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#383E54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Window.Resources>

    <!-- Main Outer Container with Drop Shadow -->
    <Border Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.7"/>
        </Border.Effect>
        <Border Background="#16181F" 
                BorderBrush="#2A2D3A" 
                BorderThickness="1" 
                CornerRadius="16" 
                Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Tab Bar -->
                    <RowDefinition Height="*"/>    <!-- Tab Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="설정" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click" ToolTip="닫기">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                    </Button>
                </Grid>

                <!-- TAB BAR -->
                <Border Grid.Row="1" Background="#1A1D27" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="GeneralTabRadio" Content="일반 설정" IsChecked="True" Style="{StaticResource TabRadioButtonStyle}" Click="TabRadio_Click"/>
                        <RadioButton x:Name="ProvidersTabRadio" Content="프로바이더 및 인증" Style="{StaticResource TabRadioButtonStyle}" Click="TabRadio_Click"/>
                    </StackPanel>
                </Border>

                <!-- TAB 1: GENERAL PREFERENCES -->
                <Grid Grid.Row="2" x:Name="GeneralTabContent" Visibility="Visible">
                    <ScrollViewer Style="{StaticResource ModernDarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <!-- Interval & Threshold Section -->
                            <Border Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="자동 갱신 및 경고 기준" FontSize="12" FontWeight="SemiBold" Foreground="#818CF8" Margin="0,0,0,10"/>

                                    <!-- Auto Refresh Interval -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="자동 갱신 주기" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0"/>
                                            <TextBlock Text="백그라운드 쿼터 조회 간격" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" 
                                                  ItemsSource="{Binding RefreshIntervalOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding AutoRefreshMinutes, Mode=TwoWay}"
                                                  Style="{StaticResource DarkComboBoxStyle}"/>
                                    </Grid>

                                    <!-- Low Quota Warning Threshold -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="부족 경고 기준" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0"/>
                                            <TextBlock Text="알림 발송 잔여량 임계치" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" 
                                                  ItemsSource="{Binding WarningThresholdOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding WarningThresholdPercent, Mode=TwoWay}"
                                                  Style="{StaticResource DarkComboBoxStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- System Integration Section -->
                            <Border Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="시스템 및 알림" FontSize="12" FontWeight="SemiBold" Foreground="#818CF8" Margin="0,0,0,8"/>

                                    <!-- Notification Toggle -->
                                    <CheckBox Content="쿼터 부족 시 윈도우 알림 받기" 
                                              IsChecked="{Binding EnableNotifications, Mode=TwoWay}" 
                                              Style="{StaticResource DarkCheckBoxStyle}"/>

                                    <!-- Auto Startup Checkbox -->
                                    <CheckBox x:Name="StartupCheckBox"
                                              Content="Windows 시작 시 자동 실행" 
                                              Checked="StartupCheckBox_Changed"
                                              Unchecked="StartupCheckBox_Changed"
                                              Style="{StaticResource DarkCheckBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Diagnostics Section -->
                            <Border Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="진단 정보" FontSize="12" FontWeight="Medium" Foreground="#E2E8F0"/>
                                        <TextBlock Text="상태 및 버전 정보를 클립보드에 복사" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Click="CopyDiagnostics_Click" Padding="10,5">
                                        <TextBlock Text="📋 진단 정보 복사" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 2: PROVIDERS & CREDENTIALS -->
                <Grid Grid.Row="2" x:Name="ProvidersTabContent" Visibility="Collapsed">
                    <ScrollViewer Style="{StaticResource ModernDarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Margin="0,0,6,0">
                            <TextBlock Text="모니터링할 AI Provider를 선택하고 API Key를 등록하세요." FontSize="11" Foreground="#64748B" Margin="2,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding AvailableProviders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" Background="#1C1F2A" BorderBrush="#2D3346" BorderThickness="1" CornerRadius="10">
                                            <StackPanel Orientation="Vertical">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Checkbox & Title -->
                                                    <CheckBox Grid.Column="0" 
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                              Style="{StaticResource DarkCheckBoxStyle}" 
                                                              VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                                            <TextBlock Text="{Binding AuthMethod, StringFormat=' · {0}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </CheckBox>

                                                    <!-- Auth Status Badge Pill -->
                                                    <Border Grid.Column="1" 
                                                            Background="{Binding AuthStatusBgBrush}" 
                                                            CornerRadius="4" 
                                                            Padding="6,2" 
                                                            Margin="6,0,8,0" 
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AuthStatusBadgeText}" 
                                                                   FontSize="10" 
                                                                   FontWeight="Medium" 
                                                                   Foreground="{Binding AuthStatusBadgeBrush}"/>
                                                    </Border>

                                                    <!-- Action buttons (API Key / CLI Login) -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource PillButtonStyle}" 
                                                                Click="ToggleApiKeyInput_Click" 
                                                                IsEnabled="{Binding IsActionsEnabled}"
                                                                ToolTip="API Key 설정" 
                                                                Margin="2,0">
                                                            <TextBlock Text="🔑 Key" FontSize="10"/>
                                                        </Button>
                                                        <Button Style="{StaticResource PillButtonStyle}" 
                                                                Click="LaunchProviderCli_Click" 
                                                                IsEnabled="{Binding IsActionsEnabled}"
                                                                ToolTip="CLI 로그인 실행" 
                                                                Visibility="{Binding CliLoginCommand, Converter={StaticResource BoolToVis}}" 
                                                                Margin="2,0">
                                                            <TextBlock Text="🚀 CLI" FontSize="10"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Inline API Key Editor -->
                                                <StackPanel Orientation="Vertical" Margin="22,8,4,2" Visibility="{Binding IsEditingKey, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}"/>
                                                        <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Click="SaveApiKey_Click" Margin="6,0,0,0">
                                                            <TextBlock Text="저장" FontSize="10" FontWeight="Medium" Foreground="#818CF8"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- FOOTER -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="QuotaTray v1.2.0" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Click="CloseButton_Click" Padding="14,6">
                        <TextBlock Text="완료" FontSize="12" FontWeight="SemiBold" Foreground="#818CF8"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
