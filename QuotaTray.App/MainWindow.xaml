<Window x:Class="QuotaTray.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:QuotaTray.App.Converters"
        xmlns:viewmodels="clr-namespace:QuotaTray.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewmodels:QuotaViewModel}"
        Title="AI Quota"
        Width="390"
        SizeToContent="Height"
        MaxHeight="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <converters:PercentToBrushConverter x:Key="PercentToBrushConverter" />
        <converters:PercentToBackgroundBrushConverter x:Key="PercentToBgConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <!-- Ultra-Modern Dark Slim ScrollBar Style -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="#33384B" CornerRadius="2.5" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDarkScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Width="5"
                                       Margin="2,0,0,0"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#2D313E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3.5" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Track" CornerRadius="3.5" />
                            <Border x:Name="PART_Indicator" 
                                    CornerRadius="3.5" 
                                    Background="{TemplateBinding Foreground}" 
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IconButton Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D313E"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B4052"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Button Style -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D3346"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D455D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F5877"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Container with Drop Shadow -->
    <Border Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Border Background="#16181F" 
                BorderBrush="#2A2D3A" 
                BorderThickness="1" 
                CornerRadius="16" 
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Cards Area / Compact View -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AI Quota" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <Border Background="#222738" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="Live" FontSize="10" FontWeight="Medium" Foreground="#818CF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="실시간 AI 쿼터 모니터링" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Header Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Compact View Toggle -->
                        <Button Style="{StaticResource IconButtonStyle}" 
                                Click="CompactModeToggle_Click" 
                                ToolTip="{Binding CompactModeToggleTooltip}" 
                                Margin="0,0,2,0">
                            <TextBlock Text="⤢" FontSize="14" FontWeight="Bold"/>
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource IconButtonStyle}" 
                                Click="SettingsButton_Click" 
                                ToolTip="환경 설정 열기" 
                                Margin="0,0,2,0">
                            <TextBlock Text="⚙" FontSize="14"/>
                        </Button>

                        <!-- Pin Button -->
                        <Button x:Name="PinButton" 
                                Style="{StaticResource IconButtonStyle}" 
                                Click="PinButton_Click" 
                                ToolTip="창 항상 위에 고정 / 해제" 
                                Margin="0,0,2,0">
                            <TextBlock x:Name="PinIconText" Text="📌" FontSize="12" Opacity="0.6"/>
                        </Button>

                        <!-- Refresh Button -->
                        <Button x:Name="RefreshButton" 
                                Style="{StaticResource IconButtonStyle}" 
                                Click="RefreshButton_Click" 
                                IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVis}}"
                                ToolTip="모든 쿼터 지금 새로고침" 
                                Margin="0,0,2,0">
                            <TextBlock Text="↻" FontSize="15" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStory">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStory"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click" ToolTip="트레이로 닫기">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- COMPACT SUMMARY VIEW (WHEN ISCOMPACTMODE == TRUE) -->
                <Border Grid.Row="1" 
                        Background="#1E212B" 
                        BorderBrush="#2D3242" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="12,10" 
                        Margin="0,0,0,10"
                        Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ActiveProviders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14161E" BorderBrush="#252A3B" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding PrimaryRemainingPercentText}" FontSize="11" FontWeight="Bold" Foreground="{Binding RemainingBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- DETAILED PROVIDERS CARDS (WHEN ISCOMPACTMODE == FALSE) -->
                <ScrollViewer Grid.Row="1" 
                              Style="{StaticResource ModernDarkScrollViewer}" 
                              VerticalScrollBarVisibility="Auto" 
                              MaxHeight="750"
                              Visibility="{Binding IsDetailedMode, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ActiveProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E212B" 
                                        BorderBrush="#2D3242" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="14,12" 
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Card Header -->
                                            <RowDefinition Height="Auto"/> <!-- Card Body / Windows -->
                                            <RowDefinition Height="Auto"/> <!-- Expanded Models -->
                                        </Grid.RowDefinitions>

                                        <!-- Card Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Badge Icon -->
                                            <Border Grid.Column="0" Width="28" Height="28" Background="{Binding IconBgColor}" CornerRadius="7" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding IconLetter}" FontWeight="Bold" FontSize="13" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Subtitle / Plan -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,6,0"/>
                                                    <Border Background="#2A3042" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="{Binding PlanType, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PlanType}" FontSize="10" FontWeight="Medium" Foreground="#94A3B8"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailsSubtitle}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding DetailsSubtitle, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- Remaining % Chip or Balance Chip -->
                                            <Border Grid.Column="2" 
                                                    Background="{Binding RemainingBgBrush}" 
                                                    CornerRadius="6" 
                                                    Padding="8,3" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrimaryRemainingPercentText}" 
                                                           FontWeight="Bold" 
                                                           FontSize="13" 
                                                           Foreground="{Binding RemainingBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Card Body -->
                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                            <!-- Success State: Quota Windows (Codex / Antigravity / Claude / Copilot / OpenRouter) -->
                                            <ItemsControl ItemsSource="{Binding Windows}" Visibility="{Binding HasWindows, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,3,0,5">
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                                                                <TextBlock Text="{Binding FormattedResetIn}" 
                                                                           FontSize="11" 
                                                                           Foreground="#64748B" 
                                                                           HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}" 
                                                                         Value="{Binding RemainingPercent}" 
                                                                         Maximum="100" 
                                                                         Foreground="{Binding RemainingPercent, Converter={StaticResource PercentToBrushConverter}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Toggle Models Link (for Antigravity and other multi-model providers) -->
                                            <Button Style="{StaticResource IconButtonStyle}" 
                                                    Click="ToggleProviderModels_Click" 
                                                    HorizontalAlignment="Left" 
                                                    Margin="0,4,0,0" 
                                                    Padding="0"
                                                    Visibility="{Binding HasModels, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ModelsToggleText}" FontSize="11" Foreground="#818CF8"/>
                                            </Button>

                                            <!-- Success State: Models-only without Windows (Fallback) -->
                                            <StackPanel Visibility="{Binding HasModelsOnly, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="가장 적게 남은 모델" FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding ResetText}" 
                                                               FontSize="11" 
                                                               Foreground="#64748B" 
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource ModernProgressBarStyle}" 
                                                             Value="{Binding PrimaryRemainingPercent}" 
                                                             Maximum="100" 
                                                             Foreground="{Binding PrimaryRemainingPercent, Converter={StaticResource PercentToBrushConverter}}"/>
                                            </StackPanel>

                                            <!-- Unauthenticated / Missing Auth State -->
                                            <StackPanel Orientation="Vertical" Visibility="{Binding IsAuthMissing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ErrorMessage}" 
                                                           FontSize="11" 
                                                           Foreground="#F59E0B" 
                                                           TextWrapping="Wrap" 
                                                           Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource PillButtonStyle}" 
                                                            Click="CardAuthSettings_Click" 
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="🔑 API Key 설정" FontSize="11"/>
                                                    </Button>
                                                    <Button Style="{StaticResource PillButtonStyle}" 
                                                            Click="CardCliLogin_Click" 
                                                            Visibility="{Binding HasCliLoginCommand, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="🚀 CLI 로그인" FontSize="11"/>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- General Error State (non-auth) -->
                                            <TextBlock Text="{Binding ErrorMessage}" 
                                                       FontSize="11" 
                                                       Foreground="#EF4444" 
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsSuccess, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAuthMissing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Expanded Models Sub-view (for Antigravity) -->
                                        <Border Grid.Row="2" 
                                                Background="#14161E" 
                                                BorderBrush="#252936" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="8,6" 
                                                Margin="0,8,0,0"
                                                MaxHeight="180"
                                                Visibility="{Binding IsModelsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ScrollViewer Style="{StaticResource ModernDarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Models}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="65"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <ProgressBar Grid.Column="1" Style="{StaticResource ModernProgressBarStyle}" Value="{Binding RemainingPercent}" Maximum="100" VerticalAlignment="Center" Margin="4,0" Foreground="{Binding RemainingPercent, Converter={StaticResource PercentToBrushConverter}}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding RemainingPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Medium" Foreground="{Binding RemainingPercent, Converter={StaticResource PercentToBrushConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding FormattedResetIn}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- FOOTER -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{Binding StatusMessage}" 
                               FontSize="11" 
                               Foreground="#64748B" 
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Style="{StaticResource IconButtonStyle}" 
                            Click="RefreshButton_Click" 
                            Visibility="{Binding IsRefreshFailed, Converter={StaticResource BoolToVis}}" 
                            Padding="4,1">
                        <TextBlock Text="다시 시도" FontSize="11" FontWeight="Medium" Foreground="#EF4444"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
